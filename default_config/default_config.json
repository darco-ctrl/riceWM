{
    "name": "RiceWM Default Config",
    "window_search": {
        "window_width": 600,
        "search_box": {
            "placeholder_text": "Search window . . ."
        },
        "behavior": {
            "max_results_shown": 3
        }
    },
    "virtual_desktop": {
        "loop": false,
        "notifier": {
            "enabled": true,
            "auto_hide_time": 3000,
            "hide_on_hover": true,
            "desktop_name": {
                "prefix": "- ",
                "suffix": " -",
                "max_char_length": 12
            },
            "window_animation": {
                "fade_in": {
                    "duration": 200
                },
                "fade_out": {
                    "duration": 300
                }
            },
            "label_animation": {
                "fade_in": {
                    "duration": 200
                },
                "fade_out": {
                    "duration": 200
                }
            }
        }
    }
}
