{
    "application": {
        "restart_application": "<ctrl>+<alt>+f12"
    },
    "window_search": {
        "close_window": "<esc>",
        "toggle": "<ctrl>+<alt>+\\",
        "select_up": "<ctrl>+w",
        "select_down": "<ctrl>+s"
    },
    "window_manager": {
        "virtual_desktop": {
            "go_left": "<ctrl>+<alt>+a",
            "go_right": "<ctrl>+<alt>+d",
            "create_new": "<ctrl>+<shift>+<alt>+n",
            "delete_current": "<ctrl>+<alt>+<shift>+q"
        },
        "window_controls": {
            "maximize": "<ctrl>+<alt>+w",
            "minimize": "<ctrl>+<alt>+x",
            "close": "<ctrl>+<alt>+q",
            "restore": "<ctrl>+<alt>+s"
        }
    }
